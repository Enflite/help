{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/index.js",
      "bindings": [
        { "type": "service", "service": "client", "format": "url", "env": "CLIENT_URL" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/go", "destination": { "service": "server" } },
    { "source": "/go/(.*)", "destination": { "service": "server" } },
    { "source": "/assets/(.*)", "destination": { "service": "client" } },
    { "source": "/icons/(.*)", "destination": { "service": "client" } },
    { "source": "/files/(.*)", "destination": { "service": "client" } },
    { "source": "/enflite-logo.png", "destination": { "service": "client" } },
    { "source": "/(.*)", "destination": { "service": "server" } }
  ]
}
