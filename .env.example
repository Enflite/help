# Copy to .env in the repo root for local runs. npm run dev, npm start and npm run seed read it
# (Node 20.12+). Variables already set in the environment win over the file.
MONGODB_URI=mongodb://127.0.0.1:27017/enflite-help
PORT=3000

# Enflite AI chat (optional). AI_API_URL is the backend-ai API root, without /api/v1.
# The account below logs in to backend-ai and its conversations belong to the help site.
# AI_API_URL=
# AI_SERVICE_EMAIL=
# AI_SERVICE_PASSWORD=
